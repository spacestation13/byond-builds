# Cloudflare R2 (S3-compatible) credentials
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API Token
# Choose "Object Read & Write" permissions
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public base URL for file links (your R2 custom domain)
R2_PUBLIC_BASE_URL=

# Cache controls
R2_CACHE_CONTROL=public, max-age=31536000, immutable
R2_CACHE_CONTROL_LATEST=public, max-age=300
R2_CACHE_CONTROL_HTML=public, max-age=300
